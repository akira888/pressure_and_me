<% content_for :title, "分析 | 気圧とわたし" %>
<section class="page-intro">
  <p class="eyebrow">記録を振り返る</p>
  <h1>体調と気圧のつながり</h1>
  <p>毎日の記録を、これからの気づきに。</p>
</section>
<section class="card">
  <div class="card-header"><h2>最近の記録</h2><span class="small-note">直近20件・毎正時の気圧</span></div>
  <% if @condition_logs.empty? %>
    <div class="empty-state"><p>体調を記録すると、気圧との変化をここで確認できます。</p></div>
  <% else %>
    <div class="analysis-list">
      <% @condition_logs.each do |log| %>
        <% metrics = @weather_metrics.fetch(log.id) %>
        <article class="analysis-item">
          <div class="analysis-item-header">
            <strong><%= log.recorded_at.in_time_zone.strftime("%-m月%-d日 %H:%M") %></strong>
            <span class="small-note">だるさ <%= log.fatigue %> / 10</span>
          </div>
          <% if metrics[:pressure] %>
            <dl class="metric-grid">
              <div><dt>気圧</dt><dd><%= number_with_precision(metrics[:pressure], precision: 1) %> hPa</dd></div>
              <% [3, 6, 12, 24].each do |hours| %>
                <div><dt>Δ<%= hours %>h</dt><dd><%= metrics[:changes][hours] ? number_with_precision(metrics[:changes][hours], precision: 1) : "—" %></dd></div>
              <% end %>
            </dl>
            <p class="small-note metric-range">気圧レンジ（6h / 24h）：<%= metrics[:ranges][6] ? number_with_precision(metrics[:ranges][6], precision: 1) : "—" %> / <%= metrics[:ranges][24] ? number_with_precision(metrics[:ranges][24], precision: 1) : "—" %> hPa</p>
          <% else %>
            <p class="small-note">この時刻の気圧データはまだありません。</p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
<section class="card">
  <div class="card-header"><h2>最近の傾向</h2><span class="small-note">全体 <%= @condition_logs.size %>件</span></div>
  <dl class="trend-grid">
    <% { headache: "頭痛", nausea: "気持ち悪さ", fatigue: "だるさ", appetite: "食欲", clarity: "クリアさ" }.each do |score, label| %>
      <% summary = @score_summary.fetch(score) %>
      <div><dt><%= label %></dt><dd><%= summary[:average] ? number_with_precision(summary[:average], precision: 1) : "—" %><small> / 10</small></dd></div>
    <% end %>
  </dl>
  <p class="small-note">平均値は保存済みの体調ログ全件から計算しています。</p>
</section>
